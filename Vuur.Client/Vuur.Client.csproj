<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
  </PropertyGroup>

  <!-- Build Tailwind CSS during dotnet build/publish when package.json is present. -->
  <Target Name="BuildTailwind" BeforeTargets="Build;Publish" Condition="Exists('package.json')">
    <!-- Install dependencies if node_modules is missing -->
    <Exec WorkingDirectory="$(MSBuildProjectDirectory)" Command="if not exist node_modules npm ci" />
    <!-- Build the CSS output (writes to wwwroot/app.css) -->
    <Exec WorkingDirectory="$(MSBuildProjectDirectory)" Command="npm run build:css" />
  </Target>

</Project>
