@* MainLayout.razor *@
@inherits LayoutComponentBase
@using Vuur.Models

<CascadingValue Value="this">
    <div class="min-h-screen flex flex-col bg-[#0D0D0D]">

        <NavBar OnCartOpen="OpenCart" />

        <CartSidebar @bind-IsOpen="CartOpen" />

        <main class="flex-1">
            @Body
        </main>

        <Footer />

    </div>
</CascadingValue>

@code {
    private bool CartOpen = false;
    
    void OpenCart()
    {
        CartOpen = true;
        StateHasChanged(); // 👈 force re-render
    }
    
    public void TriggerOpenCart()
    {
        OpenCart();
    }
}
