<!-- Footer.razor -->
<footer class="bg-[#0A0A0A] border-t border-[#1A1A1A] mt-auto">
    <!-- Main Footer Content -->
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-14">
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-10">

            <!-- Brand Column -->
            <div class="lg:col-span-1">
                <div class="flex items-center gap-2 mb-4">
                    <div class="w-8 h-8 bg-[#F25B29] rounded flex items-center justify-center">
                        <svg class="w-5 h-5 text-white" fill="currentColor" viewBox="0 0 24 24">
                            <path d="M21 6H3c-1.1 0-2 .9-2 2v8c0 1.1.9 2 2 2h18c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2zm-10 7H8v3H6v-3H3v-2h3V8h2v3h3v2zm4.5 2c-.83 0-1.5-.67-1.5-1.5S14.67 12 15.5 12s1.5.67 1.5 1.5S16.33 15 15.5 15zm3-3c-.83 0-1.5-.67-1.5-1.5S17.67 10 18.5 10s1.5.67 1.5 1.5S19.33 12 18.5 12z"/>
                        </svg>
                    </div>
                    <span class="text-white font-bold text-xl tracking-tight">
                        VU<span class="text-[#F25B29]">UR</span>
                    </span>
                </div>
                <p class="text-gray-500 text-sm leading-relaxed mb-6">
                    De centrale plek voor al je gamekeys en fysieke games. Snel, veilig en overzichtelijk.
                </p>
                <!-- Social Icons -->
                <div class="flex items-center gap-3">
                    <a href="#" class="w-9 h-9 bg-[#1A1A1A] hover:bg-[#F25B29] border border-[#2A2A2A] hover:border-[#F25B29] rounded-lg flex items-center justify-center text-gray-400 hover:text-white transition-all duration-200">
                        <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M24 4.557a9.83 9.83 0 01-2.828.775 4.932 4.932 0 002.165-2.724 9.864 9.864 0 01-3.127 1.195 4.916 4.916 0 00-8.384 4.482C7.69 8.095 4.067 6.13 1.64 3.162a4.822 4.822 0 00-.666 2.475c0 1.71.87 3.213 2.188 4.096a4.904 4.904 0 01-2.228-.616v.06a4.923 4.923 0 003.946 4.827 4.996 4.996 0 01-2.212.085 4.936 4.936 0 004.604 3.417 9.867 9.867 0 01-6.102 2.105c-.39 0-.779-.023-1.17-.067a13.995 13.995 0 007.557 2.209c9.053 0 13.998-7.496 13.998-13.985 0-.21 0-.42-.015-.63A9.935 9.935 0 0024 4.557z"/></svg>
                    </a>
                    <a href="#" class="w-9 h-9 bg-[#1A1A1A] hover:bg-[#F25B29] border border-[#2A2A2A] hover:border-[#F25B29] rounded-lg flex items-center justify-center text-gray-400 hover:text-white transition-all duration-200">
                        <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M20.317 4.37a19.791 19.791 0 00-4.885-1.515.074.074 0 00-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 00-5.487 0 12.64 12.64 0 00-.617-1.25.077.077 0 00-.079-.037A19.736 19.736 0 003.677 4.37a.07.07 0 00-.032.027C.533 9.046-.32 13.58.099 18.057a.082.082 0 00.031.057 19.9 19.9 0 005.993 3.03.078.078 0 00.084-.028c.462-.63.874-1.295 1.226-1.994a.076.076 0 00-.041-.106 13.107 13.107 0 01-1.872-.892.077.077 0 01-.008-.128 10.2 10.2 0 00.372-.292.074.074 0 01.077-.01c3.928 1.793 8.18 1.793 12.062 0a.074.074 0 01.078.01c.12.098.246.198.373.292a.077.077 0 01-.006.127 12.299 12.299 0 01-1.873.892.077.077 0 00-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 00.084.028 19.839 19.839 0 006.002-3.03.077.077 0 00.032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 00-.031-.03z"/></svg>
                    </a>
                    <a href="#" class="w-9 h-9 bg-[#1A1A1A] hover:bg-[#F25B29] border border-[#2A2A2A] hover:border-[#F25B29] rounded-lg flex items-center justify-center text-gray-400 hover:text-white transition-all duration-200">
                        <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M19.59 6.69a4.83 4.83 0 01-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 01-2.88 2.5 2.89 2.89 0 01-2.89-2.89 2.89 2.89 0 012.89-2.89c.28 0 .54.04.79.1V9.01a6.33 6.33 0 00-.79-.05 6.34 6.34 0 00-6.34 6.34 6.34 6.34 0 006.34 6.34 6.34 6.34 0 006.33-6.34V8.69a8.18 8.18 0 004.78 1.52V6.76a4.85 4.85 0 01-1.01-.07z"/></svg>
                    </a>
                </div>
            </div>

            <!-- Shop Links -->
            <div>
                <h4 class="text-white font-bold text-sm uppercase tracking-wider mb-4">Webshop</h4>
                <ul class="space-y-2.5">
                    <li><a href="/catalog" class="text-gray-500 hover:text-[#F25B29] text-sm transition-colors duration-200">Alle Games</a></li>
                    <li><a href="/deals" class="text-gray-500 hover:text-[#F25B29] text-sm transition-colors duration-200">Deals & Aanbiedingen</a></li>
                    <li><a href="/catalog?type=digital" class="text-gray-500 hover:text-[#F25B29] text-sm transition-colors duration-200">Digitale Keys</a></li>
                    <li><a href="/catalog?type=physical" class="text-gray-500 hover:text-[#F25B29] text-sm transition-colors duration-200">Fysieke Games</a></li>
                    <li><a href="/catalog?platform=pc" class="text-gray-500 hover:text-[#F25B29] text-sm transition-colors duration-200">PC Games</a></li>
                    <li><a href="/catalog?platform=console" class="text-gray-500 hover:text-[#F25B29] text-sm transition-colors duration-200">Console Games</a></li>
                </ul>
            </div>

            <!-- Account Links -->
            <div>
                <h4 class="text-white font-bold text-sm uppercase tracking-wider mb-4">Mijn Account</h4>
                <ul class="space-y-2.5">
                    <li><a href="/login" class="text-gray-500 hover:text-[#F25B29] text-sm transition-colors duration-200">Inloggen</a></li>
                    <li><a href="/register" class="text-gray-500 hover:text-[#F25B29] text-sm transition-colors duration-200">Registreren</a></li>
                    <li><a href="/account" class="text-gray-500 hover:text-[#F25B29] text-sm transition-colors duration-200">Accountinstellingen</a></li>
                    <li><a href="/orders" class="text-gray-500 hover:text-[#F25B29] text-sm transition-colors duration-200">Mijn Bestellingen</a></li>
                    <li><a href="/library" class="text-gray-500 hover:text-[#F25B29] text-sm transition-colors duration-200">Game Library</a></li>
                    <li><a href="/wishlist" class="text-gray-500 hover:text-[#F25B29] text-sm transition-colors duration-200">Wishlist</a></li>
                </ul>
            </div>

            <!-- Support Links -->
            <div>
                <h4 class="text-white font-bold text-sm uppercase tracking-wider mb-4">Ondersteuning</h4>
                <ul class="space-y-2.5">
                    <li><a href="/faq" class="text-gray-500 hover:text-[#F25B29] text-sm transition-colors duration-200">Veelgestelde Vragen</a></li>
                    <li><a href="/contact" class="text-gray-500 hover:text-[#F25B29] text-sm transition-colors duration-200">Contact</a></li>
                    <li><a href="/privacy" class="text-gray-500 hover:text-[#F25B29] text-sm transition-colors duration-200">Privacybeleid</a></li>
                    <li><a href="/terms" class="text-gray-500 hover:text-[#F25B29] text-sm transition-colors duration-200">Algemene Voorwaarden</a></li>
                    <li><a href="/returns" class="text-gray-500 hover:text-[#F25B29] text-sm transition-colors duration-200">Retourbeleid</a></li>
                </ul>
            </div>
        </div>
    </div>

    <!-- Bottom Bar -->
    <div class="border-t border-[#1A1A1A]">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-5 flex flex-col sm:flex-row items-center justify-between gap-3">
            <p class="text-gray-600 text-xs">
                © @DateTime.Now.Year VUUR. Alle rechten voorbehouden.
            </p>
            <!-- Payment Icons placeholder -->
            <div class="flex items-center gap-2">
                <span class="text-gray-700 text-xs mr-1">Betaalmethoden:</span>
                @foreach (var method in new[] { "iDEAL", "VISA", "MC", "PayPal" })
                {
                    <div class="bg-[#1A1A1A] border border-[#2A2A2A] rounded px-2 py-1 text-gray-500 text-xs font-medium">
                        @method
                    </div>
                }
            </div>
        </div>
    </div>
</footer>
