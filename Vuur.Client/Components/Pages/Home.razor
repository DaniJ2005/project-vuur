@page "/"

<PageTitle>Vuur – Jouw Gamekeys & Fysieke Games</PageTitle>

<!-- ===================== HERO SECTION ===================== -->
<section class="relative min-h-screen flex items-center justify-center overflow-hidden bg-[#0D0D0D] pt-16">
    <!-- Background grid pattern -->
    <div class="absolute inset-0 opacity-10"
         style="background-image: linear-gradient(#F25B29 1px, transparent 1px), linear-gradient(90deg, #F25B29 1px, transparent 1px); background-size: 60px 60px;">
    </div>
    <!-- Orange glow -->
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[400px] bg-[#F25B29] opacity-10 rounded-full blur-[120px] pointer-events-none"></div>

    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <div class="inline-flex items-center gap-2 bg-[#F25B29]/10 border border-[#F25B29]/30 rounded-full px-4 py-1.5 mb-8">
            <span class="w-2 h-2 bg-[#F25B29] rounded-full animate-pulse"></span>
            <span class="text-[#F25B29] text-sm font-medium">Honderden games beschikbaar</span>
        </div>

        <h1 class="text-5xl md:text-7xl font-black text-white leading-none tracking-tight mb-6">
            Jouw games.<br />
            <span class="text-[#F25B29]">Direct speelbaar.</span>
        </h1>

        <p class="text-gray-400 text-lg md:text-xl max-w-2xl mx-auto mb-10 leading-relaxed">
            Koop digitale gamekeys en fysieke games op één centrale plek. Geen gedoe met meerdere platforms — gewoon spelen.
        </p>

        <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
            <a href="/catalog" class="w-full sm:w-auto bg-[#F25B29] hover:bg-[#d94e22] text-white font-bold px-8 py-4 rounded-md text-lg transition-all duration-200 hover:scale-105 hover:shadow-[0_0_30px_rgba(242,91,41,0.4)]">
                Bekijk Catalogus
            </a>
            <a href="/deals" class="w-full sm:w-auto border border-[#333] hover:border-[#F25B29] text-gray-300 hover:text-[#F25B29] font-bold px-8 py-4 rounded-md text-lg transition-all duration-200">
                Bekijk Deals →
            </a>
        </div>

        <!-- Stats bar -->
        <div class="mt-20 grid grid-cols-3 gap-4 max-w-lg mx-auto border border-[#1E1E1E] rounded-xl p-6 bg-[#111]">
            <div class="text-center">
                <div class="text-2xl font-black text-[#FFFFFF]">2.500+</div>
                <div class="text-gray-500 text-xs mt-1">Games</div>
            </div>
            <div class="text-center border-x border-[#1E1E1E]">
                <div class="text-2xl font-black text-[#FFFFFF]">€1,99</div>
                <div class="text-gray-500 text-xs mt-1">Vanaf</div>
            </div>
            <div class="text-center">
                <div class="text-2xl font-black text-[#FFFFFF]">Direct</div>
                <div class="text-gray-500 text-xs mt-1">Levering</div>
            </div>
        </div>
    </div>
</section>

<!-- ===================== FEATURED DEALS ===================== -->
<section class="bg-[#0D0D0D] py-20 border-t border-[#1A1A1A]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex items-center justify-between mb-10">
            <div>
                <h2 class="text-3xl font-black text-white">🔥 Hot Deals</h2>
                <p class="text-gray-500 mt-1 text-sm">Beperkte tijd. Grijp je kans.</p>
            </div>
            <a href="/deals" class="text-[#F25B29] hover:text-[#d94e22] font-semibold text-sm transition-colors">
                Alle deals →
            </a>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
            @foreach (var game in FeaturedGames)
            {
                <div class="group bg-[#111] border border-[#1E1E1E] hover:border-[#F25B29]/50 rounded-xl overflow-hidden transition-all duration-300 hover:shadow-[0_8px_30px_rgba(242,91,41,0.15)] hover:-translate-y-1">
                    <!-- Game Thumbnail -->
                    <div class="relative aspect-[3/4] bg-[#1A1A1A] overflow-hidden">
                        <img src="@($"https://placehold.co/300x400/1a1a1a/F25B29?text={Uri.EscapeDataString(game.Title)}")"
                             alt="@game.Title"
                             class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
                        @if (game.DiscountPercent > 0)
                        {
                            <div class="absolute top-2 left-2 bg-[#F25B29] text-white text-xs font-black px-2 py-1 rounded">
                                -@game.DiscountPercent%
                            </div>
                        }
                        <div class="absolute top-2 right-2 bg-[#0D0D0D]/80 backdrop-blur-sm border border-[#333] text-gray-300 text-xs px-2 py-1 rounded">
                            @game.Platform
                        </div>
                    </div>
                    <!-- Game Info -->
                    <div class="p-4">
                        <h3 class="text-white font-bold text-sm leading-tight mb-1 line-clamp-2">@game.Title</h3>
                        <div class="flex items-center gap-1 mb-3">
                            <div class="flex text-[#F25B29] text-xs">★★★★☆</div>
                            <span class="text-gray-500 text-xs">(@game.Reviews)</span>
                        </div>
                        <div class="flex items-center justify-between">
                            <div>
                                @if (game.OriginalPrice > game.Price)
                                {
                                    <span class="text-gray-600 text-xs line-through mr-1">€@game.OriginalPrice.ToString("F2")</span>
                                }
                                <span class="text-[#F25B29] font-black text-lg">€@game.Price.ToString("F2")</span>
                            </div>
                            <button class="bg-[#F25B29] hover:bg-[#d94e22] text-white text-xs font-bold px-3 py-2 rounded-md transition-all duration-200 hover:scale-105">
                                + Kopen
                            </button>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

<!-- ===================== PLATFORMS SECTION ===================== -->
<section class="bg-[#111] py-16 border-y border-[#1A1A1A]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <h2 class="text-center text-gray-500 text-sm font-semibold uppercase tracking-widest mb-8">Beschikbaar op alle platforms</h2>
        <div class="flex flex-wrap items-center justify-center gap-6 md:gap-12">
            @foreach (var platform in Platforms)
            {
                <div class="flex flex-col items-center gap-2 opacity-50 hover:opacity-100 transition-opacity duration-200 cursor-pointer group">
                    <div class="w-12 h-12 bg-[#1A1A1A] group-hover:bg-[#F25B29]/10 border border-[#2A2A2A] group-hover:border-[#F25B29]/30 rounded-xl flex items-center justify-center transition-all duration-200">
                        <img src="@($"https://placehold.co/32x32/1a1a1a/F25B29?text={platform[0]}")" alt="@platform" class="w-6 h-6 rounded" />
                    </div>
                    <span class="text-gray-400 text-xs font-medium">@platform</span>
                </div>
            }
        </div>
    </div>
</section>

<!-- ===================== NEW RELEASES ===================== -->
<section class="bg-[#0D0D0D] py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex items-center justify-between mb-10">
            <div>
                <h2 class="text-3xl font-black text-white">Nieuw Uitgebracht</h2>
                <p class="text-gray-500 mt-1 text-sm">De nieuwste toevoegingen aan onze catalogus.</p>
            </div>
            <a href="/catalog?sort=new" class="text-[#F25B29] hover:text-[#d94e22] font-semibold text-sm transition-colors">
                Alle nieuwe games →
            </a>
        </div>

        <div class="space-y-3">
            @foreach (var game in NewReleases)
            {
                <div class="group flex items-center gap-4 bg-[#111] hover:bg-[#161616] border border-[#1E1E1E] hover:border-[#F25B29]/30 rounded-xl p-4 transition-all duration-200 cursor-pointer">
                    <img src="@($"https://placehold.co/80x80/1a1a1a/F25B29?text={Uri.EscapeDataString(game.Title.Substring(0,1))}")"
                         alt="@game.Title"
                         class="w-16 h-16 rounded-lg object-cover flex-shrink-0" />
                    <div class="flex-1 min-w-0">
                        <h3 class="text-white font-bold text-sm group-hover:text-[#F25B29] transition-colors truncate">@game.Title</h3>
                        <p class="text-gray-500 text-xs mt-0.5">@game.Genre · @game.Platform</p>
                    </div>
                    <div class="flex items-center gap-4 flex-shrink-0">
                        <span class="hidden sm:block text-gray-500 text-xs">Nieuw</span>
                        <span class="text-[#F25B29] font-black">€@game.Price.ToString("F2")</span>
                        <button class="border border-[#F25B29] text-[#F25B29] hover:bg-[#F25B29] hover:text-white text-xs font-bold px-3 py-1.5 rounded-md transition-all duration-200">
                            Kopen
                        </button>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

<!-- ===================== USP SECTION ===================== -->
<section class="bg-[#111] py-20 border-t border-[#1A1A1A]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-12">
            <h2 class="text-3xl font-black text-white mb-3">Waarom 1?</h2>
            <p class="text-gray-500 max-w-xl mx-auto">Alles op één plek. Geen gedoe. Gewoon gamen.</p>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
            @foreach (var usp in USPs)
            {
                <div class="bg-[#0D0D0D] border border-[#1E1E1E] hover:border-[#F25B29]/30 rounded-xl p-6 transition-all duration-300 group">
                    <div class="w-12 h-12 bg-[#F25B29]/10 border border-[#F25B29]/20 rounded-xl flex items-center justify-center mb-4 group-hover:bg-[#F25B29]/20 transition-colors">
                        <span class="text-2xl">@usp.Icon</span>
                    </div>
                    <h3 class="text-white font-bold text-lg mb-2">@usp.Title</h3>
                    <p class="text-gray-500 text-sm leading-relaxed">@usp.Description</p>
                </div>
            }
        </div>
    </div>
</section>

<!-- ===================== CTA BANNER ===================== -->
<section class="bg-[#0D0D0D] py-20 border-t border-[#1A1A1A]">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <div class="bg-gradient-to-br from-[#F25B29]/20 to-[#0D0D0D] border border-[#F25B29]/30 rounded-2xl p-12">
            <h2 class="text-4xl font-black text-white mb-4">
                Klaar om te beginnen?
            </h2>
            <p class="text-gray-400 text-lg mb-8">
                Maak een gratis account aan en ontdek meer dan 2.500 games.
            </p>
            <a href="/register" class="inline-flex items-center gap-2 bg-[#F25B29] hover:bg-[#d94e22] text-white font-black px-10 py-4 rounded-md text-lg transition-all duration-200 hover:scale-105 hover:shadow-[0_0_40px_rgba(242,91,41,0.4)]">
                Registreer Gratis
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
                </svg>
            </a>
        </div>
    </div>
</section>

@code {
    // ── Data Models ───────────────────────────────────────────
    private record GameItem(string Title, string Platform, string Genre, decimal Price, decimal OriginalPrice, int DiscountPercent, int Reviews);
    private record UspItem(string Icon, string Title, string Description);

    // ── Featured Games ─────────────────────────────────────────
    private List<GameItem> FeaturedGames = new()
    {
        new("Cyberpunk 2077",   "PC",    "RPG",     14.99m, 59.99m, 75, 4821),
        new("Elden Ring",       "PS5",   "Soulslike", 39.99m, 59.99m, 33, 3102),
        new("GTA VI",           "PC",    "Open World", 59.99m, 59.99m,  0,  982),
        new("Hades II",         "PC",    "Roguelike",  19.99m, 24.99m, 20, 2145),
    };

    // ── New Releases ──────────────────────────────────────────
    private List<GameItem> NewReleases = new()
    {
        new("Hollow Knight: Silksong", "PC",   "Metroidvania", 29.99m, 29.99m, 0, 0),
        new("Avowed",                  "Xbox",  "RPG",          49.99m, 49.99m, 0, 0),
        new("Monster Hunter Wilds",    "PC",    "Action RPG",   59.99m, 59.99m, 0, 0),
        new("Split Fiction",           "PC",    "Co-op",        39.99m, 39.99m, 0, 0),
        new("Like a Dragon: Pirate",   "PS5",   "JRPG",         54.99m, 54.99m, 0, 0),
    };

    // ── Platforms ─────────────────────────────────────────────
    private List<string> Platforms = new() { "Steam", "Epic", "PS5", "Xbox", "Switch", "GOG", "Ubisoft" };

    // ── USPs ──────────────────────────────────────────────────
    private List<UspItem> USPs = new()
    {
        new("⚡", "Directe Levering", "Ontvang je gamekey direct na betaling in je account. Geen wachttijd, geen gedoe."),
        new("🎮", "Alle Platforms", "Van PC tot console — wij bieden keys voor Steam, Epic, PlayStation, Xbox en meer."),
        new("🔒", "Veilig & Betrouwbaar", "Veilig betalen via onze beveiligde checkout. Al je aankopen staan overzichtelijk in je account."),
    };
}
