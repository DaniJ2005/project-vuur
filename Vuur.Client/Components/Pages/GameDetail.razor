@* Pages/GameDetail.razor *@
@page "/game/{Id:int}"
@using Vuur.Models

<PageTitle>@(Game?.Title ?? "Game") – VUUR</PageTitle>

@if (Game is null)
{
    <div class="pt-16 min-h-screen bg-[#0D0D0D] flex items-center justify-center">
        <div class="text-center">
            <p class="text-5xl mb-4">😕</p>
            <p class="text-white font-bold text-xl">Game niet gevonden</p>
            <a href="/catalog" class="text-[#F25B29] hover:underline text-sm mt-2 block">← Terug naar catalogus</a>
        </div>
    </div>
}
else
{
    <div class="pt-16 min-h-screen bg-[#0D0D0D]">

        <!-- Breadcrumb -->
        <div class="border-b border-[#1A1A1A]">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-3">
                <nav class="flex items-center gap-2 text-xs text-gray-500">
                    <a href="/" class="hover:text-[#F25B29] transition-colors">Home</a>
                    <span>/</span>
                    <a href="/catalog" class="hover:text-[#F25B29] transition-colors">Catalogus</a>
                    <span>/</span>
                    <span class="text-gray-300">@Game.Title</span>
                </nav>
            </div>
        </div>

        <!-- Main Content -->
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
            <div class="grid grid-cols-1 lg:grid-cols-3 gap-10">

                <!-- Left: Cover -->
                <div class="lg:col-span-1">
                    <div class="relative rounded-2xl overflow-hidden aspect-[3/4] bg-[#111] border border-[#1E1E1E]">
                        <img src="@($"https://placehold.co/400x533/111111/F25B29?text={Uri.EscapeDataString(Game.Title)}")"
                             alt="@Game.Title" class="w-full h-full object-cover" />
                        @if (Game.DiscountPercent > 0)
                        {
                            <div class="absolute top-4 left-4 bg-[#F25B29] text-white font-black px-3 py-1 rounded-lg text-sm">
                                -@Game.DiscountPercent%
                            </div>
                        }
                        @if (Game.IsNew)
                        {
                            <div
                                class="absolute top-4 @(Game.DiscountPercent > 0 ? "left-20" : "left-4") bg-emerald-500 text-white font-black px-3 py-1 rounded-lg text-sm">
                                NIEUW
                            </div>
                        }
                    </div>

                    <!-- Extra thumbnails (placeholder) -->
                    <div class="grid grid-cols-4 gap-2 mt-3">
                        @for (int i = 0; i < 4; i++)
                        {
                            var idx = i;
                            <div
                                class="aspect-video bg-[#111] border border-[#1E1E1E] hover:border-[#F25B29]/40 rounded-lg overflow-hidden cursor-pointer transition-all">
                                <img src="@($"https://placehold.co/100x60/111111/333333?text=IMG{idx + 1}")" alt="Screenshot"
                                     class="w-full h-full object-cover" />
                            </div>
                        }
                    </div>
                </div>

                <!-- Right: Info + Buy panel -->
                <div class="lg:col-span-2 space-y-6">

                    <!-- Title + Meta -->
                    <div>
                        <div class="flex flex-wrap items-center gap-2 mb-3">
                            <span
                            class="bg-[#1A1A1A] border border-[#2A2A2A] text-gray-400 text-xs px-2 py-0.5 rounded">@Game.Platform</span>
                            <span
                            class="bg-[#1A1A1A] border border-[#2A2A2A] text-gray-400 text-xs px-2 py-0.5 rounded">@Game.Genre</span>
                            @if (Game.Type == "key")
                            {
                                <span
                                    class="bg-blue-500/10 border border-blue-500/30 text-blue-400 text-xs px-2 py-0.5 rounded font-bold">🔑
                                    Digitale Key</span>
                                }
                            else
                                {
                                    <span
                                        class="bg-amber-500/10 border border-amber-500/30 text-amber-400 text-xs px-2 py-0.5 rounded font-bold">💿
                                        Fysieke Disc</span>
                                    }
                                </div>

                                <h1 class="text-4xl font-black text-white leading-tight mb-3">@Game.Title</h1>

                                @if (Game.Reviews > 0)
                                {
                                    <div class="flex items-center gap-2">
                                        <div class="flex text-[#F25B29]">
                                            @for (int i = 1; i <= 5; i++)
                                            {
                                                <span class="text-xl">@(i <= (int)Game.Rating ? "★" : "☆")</span>
                                            }
                                        </div>
                                        <span class="text-gray-400 text-sm">@Game.Rating.ToString("F1") / 5.0</span>
                                        <span class="text-gray-600 text-sm">(@Game.Reviews.ToString("N0") reviews)</span>
                                    </div>
                                }
                            </div>

                            <!-- Description -->
                            <div class="bg-[#111] border border-[#1E1E1E] rounded-xl p-5">
                                <h2 class="text-white font-bold mb-2 text-sm uppercase tracking-wider">Over dit spel</h2>
                                <p class="text-gray-400 text-sm leading-relaxed">@Game.Description</p>
                            </div>

                            <!-- Type uitleg banner -->
                            @if (Game.Type == "key")
                            {
                                <div class="flex items-start gap-3 bg-blue-500/5 border border-blue-500/20 rounded-xl p-4">
                                    <span class="text-2xl flex-shrink-0">🔑</span>
                                    <div>
                                        <p class="text-blue-400 font-bold text-sm">Digitale Game Key</p>
                                        <p class="text-blue-400/70 text-xs mt-0.5 leading-relaxed">
                                            Na betaling ontvang je direct een activatiecode in je account. Activeer op @Game.Platform en
                                            je kan meteen spelen. Geen wachttijd, geen verzendkosten.
                                        </p>
                                    </div>
                                </div>
                            }
                            else
                            {
                                <div class="flex items-start gap-3 bg-amber-500/5 border border-amber-500/20 rounded-xl p-4">
                                    <span class="text-2xl flex-shrink-0">💿</span>
                                    <div>
                                        <p class="text-amber-400 font-bold text-sm">Fysieke Disc</p>
                                        <p class="text-amber-400/70 text-xs mt-0.5 leading-relaxed">
                                            Dit is een fysiek product dat per post wordt verzonden. Tijdens het afrekenen vragen we om
                                            een bezorgadres. Verwachte levertijd: 2–4 werkdagen.
                                        </p>
                                    </div>
                                </div>
                            }

                            <!-- Buy Box -->
                            <div class="bg-[#111] border border-[#1E1E1E] rounded-xl p-6">
                                <div class="flex items-end gap-3 mb-5">
                                    @if (Game.OriginalPrice > Game.Price)
                                    {
                                        <span class="text-gray-600 text-lg line-through">€@Game.OriginalPrice.ToString("F2")</span>
                                        <span
                                        class="bg-[#F25B29]/10 border border-[#F25B29]/30 text-[#F25B29] text-sm font-black px-2 py-0.5 rounded">-@Game.DiscountPercent%</span>
                                    }
                                    <span class="text-[#F25B29] font-black text-4xl">€@Game.Price.ToString("F2")</span>
                                </div>

                                <div class="flex flex-col sm:flex-row gap-3">
                                    <button @onclick="AddToCart"
                                            class="flex-1 bg-[#F25B29] hover:bg-[#d94e22] text-white font-black py-4 rounded-xl text-lg transition-all duration-200 hover:shadow-[0_0_25px_rgba(242,91,41,0.35)] active:scale-95 flex items-center justify-center gap-2">
                                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                                  d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13l-2.5 5m0 0h13" />
                                        </svg>
                                        In winkelwagen
                                    </button>
                                    <button
                                        class="sm:w-14 h-14 border border-[#2A2A2A] hover:border-[#F25B29]/40 rounded-xl flex items-center justify-center text-gray-500 hover:text-[#F25B29] transition-all duration-200">
                                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                                  d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />
                                        </svg>
                                    </button>
                                </div>

                                @if (AddedFeedback)
                                {
                                    <div class="mt-3 flex items-center gap-2 text-emerald-400 text-sm font-medium">
                                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                                        </svg>
                                        Toegevoegd aan je winkelwagen!
                                    </div>
                                }
                            </div>

                            <!-- Specs tabel -->
                            <div class="bg-[#111] border border-[#1E1E1E] rounded-xl overflow-hidden">
                                <h2
                                    class="text-white font-bold text-sm uppercase tracking-wider px-5 py-3 border-b border-[#1E1E1E]">
                                    Productinformatie</h2>
                                    @foreach (var (label, value) in new[]
                                                            {
                            ("Platform", Game.Platform),
                            ("Genre", Game.Genre),
                            ("Type", Game.Type == "key" ? "Digitale Key" : "Fysieke Disc"),
                            ("Taal", "Nederlands / Engels"),
                            ("Regio", "Global"),
                        })
                                    {
                                        <div class="flex px-5 py-3 border-b border-[#1A1A1A] last:border-0">
                                            <span class="text-gray-500 text-sm w-32 flex-shrink-0">@label</span>
                                            <span class="text-gray-300 text-sm">@value</span>
                                        </div>
                                    }
                                </div>

                            </div>
                        </div>

                        <!-- Related Games -->
                        <div class="mt-16">
                            <h2 class="text-2xl font-black text-white mb-6">Vergelijkbare games</h2>
                            <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-4">
                                @foreach (var related in RelatedGames)
                                {
                                    <GameCard Game="related" OnAddToCart="HandleAddToCart" />
                                }
                            </div>
                        </div>

                    </div>
                </div>
            }

@code {
    [Parameter] public int Id { get; set; }
    [CascadingParameter] private MainLayout? Layout { get; set; }

    private GameItem? Game;
    private bool AddedFeedback = false;

    private List<GameItem> RelatedGames =>
        GameStore.AllGames
            .Where(g => g.Id != Id && (g.Genre == Game?.Genre || g.Platform == Game?.Platform))
            .Take(5)
            .ToList();

    protected override void OnParametersSet()
    {
        Game = GameStore.AllGames.FirstOrDefault(g => g.Id == Id);
    }

    async Task AddToCart()
    {
        if (Game is null) return;
        CartService.AddToCart(Game);
        Layout?.TriggerOpenCart();
        AddedFeedback = true;
        await Task.Delay(2000);
        AddedFeedback = false;
    }
    
    void HandleAddToCart(GameItem game)
    {
        CartService.AddToCart(game);
        Layout?.TriggerOpenCart();
    }
}
