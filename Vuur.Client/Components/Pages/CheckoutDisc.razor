@* Pages/CheckoutDisc.razor *@
@* Checkout flow voor fysieke discs – adres vereist *@
@page "/checkout/disc"
@using Vuur.Models
@inject NavigationManager Nav

<PageTitle>Afrekenen – Bezorging – VUUR</PageTitle>

<div class="pt-16 min-h-screen bg-[#0D0D0D]">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-10">

        <!-- Progress Steps -->
        <div class="flex items-center justify-center gap-3 mb-10">
            @foreach (var (label, step) in new[] { ("Bezorgadres", 1), ("Betaling", 2), ("Bevestiging", 3) })
            {
                <div class="flex items-center gap-2">
                    <div class="@($"w-7 h-7 rounded-full flex items-center justify-center text-xs font-black {(CurrentStep >= step ? "bg-[#F25B29] text-white" : "bg-[#1A1A1A] border border-[#2A2A2A] text-gray-600")}")">
                        @if (CurrentStep > step)
                        {
                            <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"/>
                            </svg>
                        }
                        else { @step }
                    </div>
                    <span class="@($"text-xs font-medium {(CurrentStep >= step ? "text-white" : "text-gray-600")}")">@label</span>
                    @if (step < 3)
                    {
                        <div class="w-8 h-px @(CurrentStep > step ? "bg-[#F25B29]" : "bg-[#2A2A2A]")"></div>
                    }
                </div>
            }
        </div>

        @if (CurrentStep == 1)
        {
            <!-- STAP 1: Adresgegevens -->
            <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
                <div class="lg:col-span-2 space-y-4">

                    <!-- Disc notice -->
                    <div class="flex items-start gap-3 bg-amber-500/5 border border-amber-500/20 rounded-xl p-4">
                        <span class="text-2xl flex-shrink-0">💿</span>
                        <div>
                            <p class="text-amber-400 font-bold text-sm">Fysieke bezorging</p>
                            <p class="text-amber-400/70 text-xs mt-0.5">Je bestelling bevat fysieke discs. Vul hieronder je bezorgadres in. Verwachte levertijd: 2–4 werkdagen.</p>
                        </div>
                    </div>

                    <div class="bg-[#111] border border-[#1E1E1E] rounded-2xl p-6">
                        <h2 class="text-white font-black text-lg mb-5">Persoonlijke gegevens</h2>
                        <div class="grid grid-cols-2 gap-4">
                            <div>
                                <label class="@LabelClass">Voornaam</label>
                                <input @bind="FirstName" placeholder="Jan" class="@InputClass" />
                            </div>
                            <div>
                                <label class="@LabelClass">Achternaam</label>
                                <input @bind="LastName" placeholder="de Vries" class="@InputClass" />
                            </div>
                            <div class="col-span-2">
                                <label class="@LabelClass">E-mailadres</label>
                                <input @bind="Email" type="email" placeholder="jan@example.com" class="@InputClass" />
                            </div>
                            <div class="col-span-2">
                                <label class="@LabelClass">Telefoonnummer</label>
                                <input @bind="Phone" type="tel" placeholder="+31 6 12345678" class="@InputClass" />
                            </div>
                        </div>
                    </div>

                    <div class="bg-[#111] border border-[#1E1E1E] rounded-2xl p-6">
                        <h2 class="text-white font-black text-lg mb-5">Bezorgadres</h2>
                        <div class="grid grid-cols-2 gap-4">
                            <div class="col-span-2">
                                <label class="@LabelClass">Straatnaam</label>
                                <input @bind="Street" placeholder="Voorbeeldstraat" class="@InputClass" />
                            </div>
                            <div>
                                <label class="@LabelClass">Huisnummer</label>
                                <input @bind="HouseNumber" placeholder="42" class="@InputClass" />
                            </div>
                            <div>
                                <label class="@LabelClass">Toevoeging</label>
                                <input @bind="HouseExt" placeholder="A" class="@InputClass" />
                            </div>
                            <div>
                                <label class="@LabelClass">Postcode</label>
                                <input @bind="PostCode" placeholder="1234 AB" class="@InputClass" />
                            </div>
                            <div>
                                <label class="@LabelClass">Stad</label>
                                <input @bind="City" placeholder="Amsterdam" class="@InputClass" />
                            </div>
                            <div class="col-span-2">
                                <label class="@LabelClass">Land</label>
                                <select @bind="Country" class="@InputClass">
                                    <option value="NL">Nederland</option>
                                    <option value="BE">België</option>
                                    <option value="DE">Duitsland</option>
                                    <option value="FR">Frankrijk</option>
                                </select>
                            </div>
                        </div>
                    </div>

                    <!-- Shipping method -->
                    <div class="bg-[#111] border border-[#1E1E1E] rounded-2xl p-6">
                        <h2 class="text-white font-black text-lg mb-4">Verzendmethode</h2>
                        <div class="space-y-3">
                            @foreach (var ship in ShippingOptions)
                            {
                                <label class="@($"flex items-center justify-between gap-4 p-4 rounded-xl border cursor-pointer transition-all {(SelectedShipping == ship.id ? "border-[#F25B29]/50 bg-[#F25B29]/5" : "border-[#2A2A2A] hover:border-[#3A3A3A]")}")">
                                    <div class="flex items-center gap-3">
                                        <input type="radio" name="shipping" value="@ship.id" @onchange="() => SelectedShipping = ship.id" class="accent-[#F25B29]" />
                                        <span class="text-xl">@ship.icon</span>
                                        <div>
                                            <p class="text-white text-sm font-bold">@ship.name</p>
                                            <p class="text-gray-500 text-xs">@ship.desc</p>
                                        </div>
                                    </div>
                                    <span class="text-[#F25B29] font-black text-sm flex-shrink-0">
                                        @(ship.price == 0 ? "Gratis" : $"€{ship.price:F2}")
                                    </span>
                                </label>
                            }
                        </div>
                    </div>

                    <button @onclick="() => CurrentStep = 2"
                            class="w-full bg-[#F25B29] hover:bg-[#d94e22] text-white font-black py-4 rounded-xl text-lg transition-all hover:shadow-[0_0_20px_rgba(242,91,41,0.3)] active:scale-95 flex items-center justify-center gap-2">
                        Doorgaan naar betaling
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
                        </svg>
                    </button>
                </div>

                <!-- Order Summary -->
                <div class="space-y-4">
                    <div class="bg-[#111] border border-[#1E1E1E] rounded-2xl p-5 sticky top-20">
                        <h3 class="text-white font-black text-base mb-4">Jouw bestelling</h3>
                        <div class="space-y-3 mb-4">
                            @foreach (var item in CartService.Items)
                            {
                                <div class="flex gap-3">
                                    <div class="w-10 h-10 bg-[#1A1A1A] rounded-lg flex-shrink-0 overflow-hidden">
                                        <img src="@($"https://placehold.co/40x40/111111/F25B29?text={item.Game.Title.Substring(0,1)}")" alt="" class="w-full h-full object-cover" />
                                    </div>
                                    <div class="flex-1 min-w-0">
                                        <p class="text-white text-xs font-bold truncate">@item.Game.Title</p>
                                        <p class="text-gray-500 text-xs">@(item.Game.Type == "disc" ? "💿 Disc" : "🔑 Key") · ×@item.Quantity</p>
                                    </div>
                                    <span class="text-[#F25B29] text-xs font-black">€@((item.Game.Price * item.Quantity).ToString("F2"))</span>
                                </div>
                            }
                        </div>
                        <div class="border-t border-[#1A1A1A] pt-4 space-y-2">
                            <div class="flex justify-between text-sm">
                                <span class="text-gray-500">Subtotaal</span>
                                <span class="text-gray-300">€@CartService.Total.ToString("F2")</span>
                            </div>
                            <div class="flex justify-between text-sm">
                                <span class="text-gray-500">Verzending</span>
                                <span class="text-gray-300">@(ShippingPrice == 0 ? "Gratis" : $"€{ShippingPrice:F2}")</span>
                            </div>
                            <div class="flex justify-between font-black pt-2 border-t border-[#1A1A1A]">
                                <span class="text-white">Totaal</span>
                                <span class="text-[#F25B29]">€@((CartService.Total + ShippingPrice).ToString("F2"))</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
        else if (CurrentStep == 2)
        {
            <!-- STAP 2: Betaling -->
            <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
                <div class="lg:col-span-2 space-y-4">

                    <!-- Adres samenvatting -->
                    <div class="bg-[#111] border border-[#1E1E1E] rounded-2xl p-5">
                        <div class="flex items-center justify-between mb-3">
                            <h3 class="text-white font-bold text-sm">Bezorgadres</h3>
                            <button @onclick="() => CurrentStep = 1" class="text-[#F25B29] text-xs hover:underline">Wijzigen</button>
                        </div>
                        <p class="text-gray-400 text-sm">@FirstName @LastName</p>
                        <p class="text-gray-500 text-sm">@Street @HouseNumber@HouseExt, @PostCode @City</p>
                        <p class="text-gray-500 text-sm">@Email</p>
                    </div>

                    <div class="bg-[#111] border border-[#1E1E1E] rounded-2xl p-6">
                        <h2 class="text-white font-black text-lg mb-5">Betaalmethode</h2>
                        <div class="space-y-3">
                            @foreach (var method in PaymentMethods)
                            {
                                <label class="@($"flex items-center gap-4 p-4 rounded-xl border cursor-pointer transition-all {(SelectedPayment == method.id ? "border-[#F25B29]/50 bg-[#F25B29]/5" : "border-[#2A2A2A] hover:border-[#3A3A3A]")}")">
                                    <input type="radio" name="payment" value="@method.id" @onchange="() => SelectedPayment = method.id" class="accent-[#F25B29]" />
                                    <span class="text-2xl">@method.icon</span>
                                    <div>
                                        <p class="text-white text-sm font-bold">@method.name</p>
                                        <p class="text-gray-500 text-xs">@method.desc</p>
                                    </div>
                                </label>
                            }
                        </div>
                        <div class="mt-4 bg-[#0D0D0D] border border-[#1E1E1E] rounded-xl p-4">
                            <p class="text-gray-500 text-xs text-center">🔒 Mock betaalomgeving. Geen echte betalingen.</p>
                        </div>
                    </div>

                    <div class="flex gap-3">
                        <button @onclick="() => CurrentStep = 1"
                                class="border border-[#2A2A2A] hover:border-[#F25B29]/30 text-gray-400 hover:text-white px-6 py-4 rounded-xl font-bold transition-all">
                            ← Terug
                        </button>
                        <button @onclick="() => CurrentStep = 3"
                                class="flex-1 bg-[#F25B29] hover:bg-[#d94e22] text-white font-black py-4 rounded-xl text-lg transition-all hover:shadow-[0_0_20px_rgba(242,91,41,0.3)] active:scale-95">
                            €@((CartService.Total + ShippingPrice).ToString("F2")) Betalen
                        </button>
                    </div>
                </div>

                <div class="space-y-4">
                    <div class="bg-[#111] border border-[#1E1E1E] rounded-2xl p-5 sticky top-20">
                        <h3 class="text-white font-black text-base mb-4">Jouw bestelling</h3>
                        <div class="space-y-3 mb-4">
                            @foreach (var item in CartService.Items)
                            {
                                <div class="flex gap-3">
                                    <div class="w-10 h-10 bg-[#1A1A1A] rounded-lg flex-shrink-0 overflow-hidden">
                                        <img src="@($"https://placehold.co/40x40/111111/F25B29?text={item.Game.Title.Substring(0,1)}")" alt="" class="w-full h-full object-cover" />
                                    </div>
                                    <div class="flex-1 min-w-0">
                                        <p class="text-white text-xs font-bold truncate">@item.Game.Title</p>
                                        <p class="text-gray-500 text-xs">@(item.Game.Type == "disc" ? "💿 Disc" : "🔑 Key") · ×@item.Quantity</p>
                                    </div>
                                    <span class="text-[#F25B29] text-xs font-black">€@((item.Game.Price * item.Quantity).ToString("F2"))</span>
                                </div>
                            }
                        </div>
                        <div class="border-t border-[#1A1A1A] pt-4 space-y-2">
                            <div class="flex justify-between text-sm">
                                <span class="text-gray-500">Subtotaal</span>
                                <span class="text-gray-300">€@CartService.Total.ToString("F2")</span>
                            </div>
                            <div class="flex justify-between text-sm">
                                <span class="text-gray-500">Verzending</span>
                                <span class="text-gray-300">@(ShippingPrice == 0 ? "Gratis" : $"€{ShippingPrice:F2}")</span>
                            </div>
                            <div class="flex justify-between font-black pt-2 border-t border-[#1A1A1A]">
                                <span class="text-white">Totaal</span>
                                <span class="text-[#F25B29]">€@((CartService.Total + ShippingPrice).ToString("F2"))</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
        else
        {
            <!-- STAP 3: Bevestiging levering -->
            <div class="max-w-2xl mx-auto text-center">
                <div class="w-20 h-20 bg-emerald-500/10 border border-emerald-500/30 rounded-full flex items-center justify-center mx-auto mb-6">
                    <svg class="w-10 h-10 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                    </svg>
                </div>
                <h1 class="text-3xl font-black text-white mb-2">Bestelling geplaatst! 🎉</h1>
                <p class="text-gray-400 mb-2">Bestelnummer: <span class="text-[#F25B29] font-mono font-bold">#VUUR-@OrderNumber</span></p>
                <p class="text-gray-500 text-sm mb-8">Een bevestigingsmail is verstuurd naar <span class="text-gray-300">@Email</span></p>

                <!-- Verzendoverzicht -->
                <div class="bg-[#111] border border-[#1E1E1E] rounded-2xl p-6 text-left mb-6">
                    <h3 class="text-white font-bold mb-4 flex items-center gap-2">
                        <span>📦</span> Verzendgegevens
                    </h3>
                    <div class="space-y-2">
                        <div class="flex justify-between text-sm">
                            <span class="text-gray-500">Bezorgadres</span>
                            <span class="text-gray-300 text-right">@Street @HouseNumber, @PostCode @City</span>
                        </div>
                        <div class="flex justify-between text-sm">
                            <span class="text-gray-500">Verzendmethode</span>
                            <span class="text-gray-300">@(ShippingOptions.FirstOrDefault(s => s.id == SelectedShipping)?.name)</span>
                        </div>
                        <div class="flex justify-between text-sm">
                            <span class="text-gray-500">Verwachte levering</span>
                            <span class="text-emerald-400 font-bold">@DateTime.Now.AddDays(3).ToString("dd MMMM yyyy")</span>
                        </div>
                    </div>
                </div>

                <!-- Items lijst -->
                <div class="bg-[#111] border border-[#1E1E1E] rounded-2xl p-6 text-left mb-8">
                    <h3 class="text-white font-bold mb-4">Bestelde producten</h3>
                    <div class="space-y-3">
                        @foreach (var item in CartService.Items)
                        {
                            <div class="flex items-center gap-3 py-2 border-b border-[#1A1A1A] last:border-0">
                                <span class="text-lg">@(item.Game.Type == "disc" ? "💿" : "🔑")</span>
                                <div class="flex-1">
                                    <p class="text-white text-sm font-bold">@item.Game.Title</p>
                                    <p class="text-gray-500 text-xs">×@item.Quantity</p>
                                </div>
                                <span class="text-[#F25B29] font-black text-sm">€@((item.Game.Price * item.Quantity).ToString("F2"))</span>
                            </div>
                        }
                    </div>
                </div>

                <div class="flex flex-col sm:flex-row gap-3 justify-center">
                    <a href="/" @onclick="() => CartService.Clear()" class="bg-[#F25B29] hover:bg-[#d94e22] text-white font-black px-8 py-3 rounded-xl transition-all">
                        Terug naar home
                    </a>
                    <a href="/catalog" class="border border-[#2A2A2A] hover:border-[#F25B29]/30 text-gray-400 hover:text-white px-8 py-3 rounded-xl font-bold transition-all">
                        Verder winkelen
                    </a>
                </div>
            </div>
        }
    </div>
</div>

@code {
    private int CurrentStep = 1;

    // Persoonlijke gegevens
    private string FirstName = "";
    private string LastName = "";
    private string Email = "";
    private string Phone = "";

    // Adresgegevens
    private string Street = "";
    private string HouseNumber = "";
    private string HouseExt = "";
    private string PostCode = "";
    private string City = "";
    private string Country = "NL";

    private string SelectedPayment = "ideal";
    private string SelectedShipping = "standard";

    private string InputClass = "w-full bg-[#0D0D0D] border border-[#2A2A2A] focus:border-[#F25B29] text-gray-300 placeholder-gray-700 rounded-lg px-4 py-3 text-sm focus:outline-none focus:ring-1 focus:ring-[#F25B29] transition-all";
    private string LabelClass = "text-gray-400 text-xs font-bold uppercase tracking-wider block mb-1.5";

    private int OrderNumber = new Random().Next(10000, 99999);

    private record ShippingOption(string id, string icon, string name, string desc, decimal price);
    private List<ShippingOption> ShippingOptions = new()
    {
        new("standard", "📮", "Standaard",   "2–4 werkdagen",  0m),
        new("express",  "⚡", "Express",     "1–2 werkdagen",  4.99m),
        new("same_day", "🚀", "Same Day",    "Vandaag bezorgd", 9.99m),
    };

    private decimal ShippingPrice => ShippingOptions.FirstOrDefault(s => s.id == SelectedShipping)?.price ?? 0m;

    private record PaymentMethod(string id, string icon, string name, string desc);
    private List<PaymentMethod> PaymentMethods = new()
    {
        new("ideal",   "🏦", "iDEAL",   "Betaal via je bank"),
        new("visa",    "💳", "Visa / Mastercard", "Creditcard betaling"),
        new("paypal",  "🅿️", "PayPal",  "Betaal via je PayPal account"),
    };
}
