@* Pages/CheckoutKey.razor *@
@* Checkout flow voor digitale keys – geen adres nodig *@
@page "/checkout/key"
@using Vuur.Models
@inject NavigationManager Nav

<PageTitle>Afrekenen – Digitale Keys – VUUR</PageTitle>

<div class="pt-16 min-h-screen bg-[#0D0D0D]">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-10">

        <!-- Progress Steps -->
        <div class="flex items-center justify-center gap-3 mb-10">
            @foreach (var (label, step) in new[] { ("Gegevens", 1), ("Betaling", 2), ("Bevestiging", 3) })
            {
                <div class="flex items-center gap-2">
                    <div class="@($"w-7 h-7 rounded-full flex items-center justify-center text-xs font-black {(CurrentStep >= step ? "bg-[#F25B29] text-white" : "bg-[#1A1A1A] border border-[#2A2A2A] text-gray-600")}")">
                        @if (CurrentStep > step)
                        {
                            <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"/>
                            </svg>
                        }
                        else { @step }
                    </div>
                    <span class="@($"text-xs font-medium {(CurrentStep >= step ? "text-white" : "text-gray-600")}")">@label</span>
                    @if (step < 3)
                    {
                        <div class="w-8 h-px @(CurrentStep > step ? "bg-[#F25B29]" : "bg-[#2A2A2A]")"></div>
                    }
                </div>
            }
        </div>

        @if (CurrentStep == 1)
        {
            <!-- STAP 1: Klantgegevens -->
            <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
                <div class="lg:col-span-2 space-y-4">
                    <div class="bg-[#111] border border-[#1E1E1E] rounded-2xl p-6">
                        <div class="flex items-center gap-2 mb-5">
                            <span class="text-lg">🔑</span>
                            <h2 class="text-white font-black text-lg">Digitale levering</h2>
                        </div>
                        <div class="bg-blue-500/5 border border-blue-500/20 rounded-xl p-4 mb-6">
                            <p class="text-blue-400 text-sm">Na betaling ontvang je jouw gamekeys direct in je account. Geen wachttijd, geen verzendkosten.</p>
                        </div>

                        <div class="grid grid-cols-2 gap-4">
                            <div>
                                <label class="text-gray-400 text-xs font-bold uppercase tracking-wider block mb-1.5">Voornaam</label>
                                <input @bind="FirstName" placeholder="Jan" class="@InputClass" />
                            </div>
                            <div>
                                <label class="text-gray-400 text-xs font-bold uppercase tracking-wider block mb-1.5">Achternaam</label>
                                <input @bind="LastName" placeholder="de Vries" class="@InputClass" />
                            </div>
                            <div class="col-span-2">
                                <label class="text-gray-400 text-xs font-bold uppercase tracking-wider block mb-1.5">E-mailadres</label>
                                <input @bind="Email" type="email" placeholder="jan@example.com" class="@InputClass" />
                                <p class="text-gray-600 text-xs mt-1">Je keys worden hier naartoe gestuurd</p>
                            </div>
                        </div>
                    </div>

                    <button @onclick="() => CurrentStep = 2"
                            class="w-full bg-[#F25B29] hover:bg-[#d94e22] text-white font-black py-4 rounded-xl text-lg transition-all hover:shadow-[0_0_20px_rgba(242,91,41,0.3)] active:scale-95 flex items-center justify-center gap-2">
                        Doorgaan naar betaling
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
                        </svg>
                    </button>
                </div>

                <!-- Order summary -->
                <OrderSummary />
            </div>
        }
        else if (CurrentStep == 2)
        {
            <!-- STAP 2: Mock Betaling -->
            <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
                <div class="lg:col-span-2 space-y-4">
                    <div class="bg-[#111] border border-[#1E1E1E] rounded-2xl p-6">
                        <h2 class="text-white font-black text-lg mb-5">Betaalmethode</h2>

                        <div class="space-y-3">
                            @foreach (var method in PaymentMethods)
                            {
                                <label class="@($"flex items-center gap-4 p-4 rounded-xl border cursor-pointer transition-all {(SelectedPayment == method.id ? "border-[#F25B29]/50 bg-[#F25B29]/5" : "border-[#2A2A2A] hover:border-[#3A3A3A]")}")">
                                    <input type="radio" name="payment" value="@method.id" @onchange="() => SelectedPayment = method.id" class="accent-[#F25B29]" />
                                    <span class="text-2xl">@method.icon</span>
                                    <div>
                                        <p class="text-white text-sm font-bold">@method.name</p>
                                        <p class="text-gray-500 text-xs">@method.desc</p>
                                    </div>
                                </label>
                            }
                        </div>

                        <div class="mt-4 bg-[#0D0D0D] border border-[#1E1E1E] rounded-xl p-4">
                            <p class="text-gray-500 text-xs text-center">🔒 Dit is een mock betaalomgeving. Geen echte betalingen.</p>
                        </div>
                    </div>

                    <div class="flex gap-3">
                        <button @onclick="() => CurrentStep = 1"
                                class="border border-[#2A2A2A] hover:border-[#F25B29]/30 text-gray-400 hover:text-white px-6 py-4 rounded-xl font-bold transition-all">
                            ← Terug
                        </button>
                        <button @onclick="ProcessPayment"
                                class="flex-1 bg-[#F25B29] hover:bg-[#d94e22] text-white font-black py-4 rounded-xl text-lg transition-all hover:shadow-[0_0_20px_rgba(242,91,41,0.3)] active:scale-95">
                            €@CartService.Total.ToString("F2") Betalen
                        </button>
                    </div>
                </div>
                <OrderSummary />
            </div>
        }
        else
        {
            <!-- STAP 3: Bevestiging + Keys -->
            <div class="max-w-2xl mx-auto text-center">
                <div class="w-20 h-20 bg-emerald-500/10 border border-emerald-500/30 rounded-full flex items-center justify-center mx-auto mb-6">
                    <svg class="w-10 h-10 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                    </svg>
                </div>
                <h1 class="text-3xl font-black text-white mb-2">Betaling geslaagd! 🎉</h1>
                <p class="text-gray-400 mb-8">Je gamekeys zijn klaar. Ze zijn ook naar @Email gestuurd.</p>

                <!-- Keys per game -->
                <div class="space-y-3 text-left mb-8">
                    @foreach (var item in CartService.Items)
                    {
                        <div class="bg-[#111] border border-emerald-500/20 rounded-xl p-4">
                            <div class="flex items-center justify-between mb-3">
                                <p class="text-white font-bold">@item.Game.Title</p>
                                <span class="text-blue-400 text-xs">🔑 KEY</span>
                            </div>
                            <div class="bg-[#0D0D0D] border border-[#2A2A2A] rounded-lg px-4 py-3 font-mono text-[#F25B29] text-sm tracking-widest text-center select-all">
                                @GenerateFakeKey(item.Game.Id)
                            </div>
                            <p class="text-gray-600 text-xs mt-2 text-center">Klik op de key om te kopiëren · Activeer op @item.Game.Platform</p>
                        </div>
                    }
                </div>

                <div class="flex flex-col sm:flex-row gap-3 justify-center">
                    <a href="/library" class="bg-[#F25B29] hover:bg-[#d94e22] text-white font-black px-8 py-3 rounded-xl transition-all">
                        Naar Mijn Library
                    </a>
                    <a href="/" @onclick="() => CartService.Clear()" class="border border-[#2A2A2A] hover:border-[#F25B29]/30 text-gray-400 hover:text-white px-8 py-3 rounded-xl font-bold transition-all">
                        Terug naar home
                    </a>
                </div>
            </div>
        }
    </div>
</div>

@code {
    private int CurrentStep = 1;
    private string FirstName = "";
    private string LastName = "";
    private string Email = "";
    private string SelectedPayment = "ideal";

    private string InputClass = "w-full bg-[#0D0D0D] border border-[#2A2A2A] focus:border-[#F25B29] text-gray-300 placeholder-gray-700 rounded-lg px-4 py-3 text-sm focus:outline-none focus:ring-1 focus:ring-[#F25B29] transition-all";

    private record PaymentMethod(string id, string icon, string name, string desc);
    private List<PaymentMethod> PaymentMethods = new()
    {
        new("ideal",   "🏦", "iDEAL",   "Betaal via je bank"),
        new("visa",    "💳", "Visa / Mastercard", "Creditcard betaling"),
        new("paypal",  "🅿️", "PayPal",  "Betaal via je PayPal account"),
        new("crypto",  "🪙", "Crypto",  "Bitcoin, Ethereum en meer"),
    };

    void ProcessPayment()
    {
        CurrentStep = 3;
    }

    string GenerateFakeKey(int seed)
    {
        var rng = new Random(seed * 31337);
        string chars = "ABCDEFGHJKLMNPQRSTUVWXYZ23456789";
        string Part() => new string(Enumerable.Range(0, 5).Select(_ => chars[rng.Next(chars.Length)]).ToArray());
        return $"{Part()}-{Part()}-{Part()}-{Part()}";
    }
}

