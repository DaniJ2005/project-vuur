# =============================================================================
# Vuur — environment variables voor docker compose
#
# Kopieer dit bestand naar `.env` in dezelfde map en vul echte waarden in:
#   cp .env.example .env
#
# Het .env bestand is gitignored — gooi hier dus gerust passwords in.
# Op de schoolserver staat een eigen .env met productie-credentials.
# =============================================================================

# -------- PostgreSQL --------
POSTGRES_USER=vuur
POSTGRES_PASSWORD=change_me_postgres
POSTGRES_DB=vuur
POSTGRES_HOST=localhost # localhost voor local development
POSTGRES_PORT=5433 # Niet aanpassen, houden op 5433 voor lokale development. De postgres container in docker compose is al geconfigureerd om op 5433 te luisteren.

# -------- CORS --------
# Cors var (optioneel), leeg laten in productie als alles via dezelfde nginx reverse proxy loopt (betekent dat frontend en API op dezelfde origin zitten, dus geen CORS nodig).
CORS_FRONTEND_ORIGIN=http://localhost:5173


# -------- MongoDB --------
# Dit zijn de root credentials van de mongo instance.
MONGO_USER=vuur
MONGO_PASSWORD=mongo_pass_example # Maakt voor local niet veel uit en server doet dit automatisch.
MONGO_HOST=localhost # Niet aanpassen, houden op localhost voor lokale development.
MONGO_PORT=27017

# -------- Redis --------
REDIS_PASSWORD=change_me_redis

# -------- JWT --------
# Genereer een lang random secret. Voorbeeld op linux/mac:
#   openssl rand -base64 48
# Op windows (powershell):
#   [Convert]::ToBase64String([System.Security.Cryptography.RandomNumberGenerator]::GetBytes(48))
JWT_SECRET=change_me_to_a_long_random_string_min_32_chars
JWT_ISSUER=vuur-api
JWT_ACCESS_TOKEN_MINUTES=15
JWT_REFRESH_TOKEN_DAYS=7

# Enable or disable swagger.
ENABLE_SWAGGER=true